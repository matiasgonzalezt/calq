<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@400;500;600;700&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#1a1a1a;--ink2:#444;--ink3:#888;--bg:#f9f8f5;--bg2:#fff;--bg3:#f0ede6;
  --red:#c84b2f;--blue:#2f6fc8;--green:#2a7a4b;--amber:#c87a2f;
  --border:#e0ddd4;
}
@media(prefers-color-scheme:dark){
  :root{--ink:#e8e5dc;--ink2:#b8b5ac;--ink3:#787570;--bg:#1a1917;--bg2:#221f1c;--bg3:#2a2722;--border:#3a3730}
}
body{font-family:'Syne',sans-serif;background:var(--bg);color:var(--ink);min-height:100vh}

/* HEADER */
.header{display:flex;align-items:baseline;gap:.5rem;padding:.6rem 1.5rem;border-bottom:1.5px solid var(--border);background:var(--bg2)}
.logo{font-size:1.35rem;font-weight:700;letter-spacing:-.02em;color:var(--ink)}
.logo span{color:var(--red)}
.logo-sub{font-size:.72rem;color:var(--ink3);letter-spacing:.06em;text-transform:uppercase;padding-left:.2rem}

/* TABS */
.tabs{display:flex;border-bottom:1px solid var(--border);background:var(--bg2);padding:0 1.5rem}
.tab{padding:.6rem 1.1rem;font-size:.82rem;font-weight:500;letter-spacing:.04em;cursor:pointer;border-bottom:2.5px solid transparent;color:var(--ink3);transition:all .15s;white-space:nowrap}
.tab.active{color:var(--red);border-bottom-color:var(--red)}
.tab:hover:not(.active){color:var(--ink)}

/* PANELS */
.panel{display:none;padding:1.1rem 1.5rem;flex:1}
.panel.active{display:block}
.col2{display:grid;grid-template-columns:1fr 1fr;gap:1rem;align-items:start}
.col3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.6rem}

/* CARDS */
.card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:.9rem 1.1rem;margin-bottom:.8rem}
.card-sm{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:.65rem .9rem;margin-bottom:.5rem}
.sec-title{font-size:.68rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3);margin-bottom:.65rem}

/* INPUTS */
label{font-size:.78rem;color:var(--ink2);display:block;margin-bottom:.25rem}
input[type=number],select{width:100%;padding:.42rem .65rem;background:var(--bg3);border:1px solid var(--border);border-radius:6px;font-family:'Syne',sans-serif;font-size:.82rem;color:var(--ink);outline:none;transition:border-color .15s}
input[type=number]:focus,select:focus{border-color:var(--red)}

/* BUTTONS */
.btn{padding:.45rem 1rem;border-radius:6px;border:none;font-family:'Syne',sans-serif;font-size:.8rem;font-weight:500;cursor:pointer;transition:all .15s}
.btn-primary{background:var(--red);color:#fff}.btn-primary:hover{opacity:.88}
.btn-secondary{background:var(--bg3);color:var(--ink);border:1px solid var(--border)}.btn-secondary:hover{background:var(--border)}
.btn-sm{padding:.3rem .65rem;font-size:.75rem}

/* SUPPORT BUTTONS — colored by type */
.support-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.75rem}
.sup-btn{padding:.5rem .4rem;border-radius:8px;border:1.5px solid var(--border);background:var(--bg3);cursor:pointer;text-align:center;font-size:.72rem;color:var(--ink3);transition:all .15s;font-family:'Syne',sans-serif;line-height:1.3}
.sup-btn svg{display:block;margin:.15rem auto .25rem}
/* simple = green */
.sup-btn.type-simple:hover,.sup-btn.type-simple.selected{border-color:var(--green);background:#e8f5ee;color:var(--green)}
/* pin/articulado = blue */
.sup-btn.type-pin:hover,.sup-btn.type-pin.selected{border-color:var(--blue);background:#e6f0fb;color:var(--blue)}
/* fixed = red */
.sup-btn.type-fixed:hover,.sup-btn.type-fixed.selected{border-color:var(--red);background:#fceee9;color:var(--red)}
/* free = gray */
.sup-btn.type-free:hover,.sup-btn.type-free.selected{border-color:var(--ink3);background:var(--bg3);color:var(--ink)}
@media(prefers-color-scheme:dark){
  .sup-btn.type-simple.selected{background:#143320}.sup-btn.type-pin.selected{background:#0d2645}.sup-btn.type-fixed.selected{background:#3a1410}.sup-btn.type-free.selected{background:#333}
}
.sup-label{display:inline-flex;align-items:center;gap:.25rem;font-size:.7rem;font-weight:600;padding:.15rem .4rem;border-radius:4px}
.sup-label.simple{background:#e8f5ee;color:var(--green)}
.sup-label.pin{background:#e6f0fb;color:var(--blue)}
.sup-label.fixed{background:#fceee9;color:var(--red)}
@media(prefers-color-scheme:dark){
  .sup-label.simple{background:#143320}.sup-label.pin{background:#0d2645}.sup-label.fixed{background:#3a1410}
}

/* LOAD LIST */
.load-item{display:flex;align-items:center;gap:.45rem;padding:.35rem .55rem;background:var(--bg3);border-radius:6px;margin-bottom:.35rem;font-size:.8rem}
.load-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.load-dot.point{background:var(--red)}.load-dot.dist{background:var(--blue)}.load-dot.moment{background:var(--amber)}
.load-name{flex:1;font-weight:500}

/* RESULTS */
.result-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:.55rem;margin-top:.6rem}
.result-card{background:var(--bg3);border-radius:8px;padding:.55rem .8rem;border-left:3px solid var(--red)}
.result-card.blue{border-left-color:var(--blue)}.result-card.green{border-left-color:var(--green)}.result-card.amber{border-left-color:var(--amber)}
.result-label{font-size:.68rem;color:var(--ink3);letter-spacing:.04em;margin-bottom:.15rem}
.result-val{font-family:'DM Mono',monospace;font-size:.95rem;font-weight:500;color:var(--ink)}

canvas{display:block;border-radius:6px}
</style>
</head>
<body>

<div class="header">
  <div class="logo">cal<span>q</span></div>
  <div class="logo-sub">Calculadora Estructural</div>
</div>

<div class="tabs">
  <div class="tab active" onclick="switchTab('mnq')">Diagramas MNQ</div>
  <div class="tab" onclick="switchTab('builder')">Constructor</div>
</div>

<!-- ===== PANEL 1: MNQ ===== -->
<div class="panel active" id="panel-mnq">
  <div class="col2">
    <!-- LEFT -->
    <div>
      <div class="card">
        <div class="sec-title">Longitud de Viga</div>
        <div><label>Longitud total (m)</label><input type="number" id="viga-L" value="6" step="0.5" min="0.5" onchange="updateDiagrams()"></div>
      </div>

      <div class="card">
        <div class="sec-title">Apoyo A <span class="sup-label simple" id="label-A">Simple</span></div>
        <div class="support-grid">
          <div class="sup-btn type-simple selected" id="supA-simple" onclick="selSup('A','simple',this)">
            <svg width="34" height="26" viewBox="0 0 34 26"><line x1="17" y1="3" x2="17" y2="17" stroke="currentColor" stroke-width="1.6"/><polygon points="17,17 9,24 25,24" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="7" y1="25" x2="27" y2="25" stroke="currentColor" stroke-width="1.6"/></svg>
            Simple
          </div>
          <div class="sup-btn type-pin" id="supA-pin" onclick="selSup('A','pin',this)">
            <svg width="34" height="26" viewBox="0 0 34 26"><line x1="17" y1="3" x2="17" y2="17" stroke="currentColor" stroke-width="1.6"/><polygon points="17,17 9,23 25,23" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="24.5" r="1.5" stroke="currentColor" fill="none" stroke-width="1.3"/></svg>
            Articulado
          </div>
          <div class="sup-btn type-fixed" id="supA-fixed" onclick="selSup('A','fixed',this)">
            <svg width="34" height="26" viewBox="0 0 34 26"><line x1="17" y1="3" x2="17" y2="20" stroke="currentColor" stroke-width="1.6"/><rect x="13" y="20" width="8" height="5" fill="currentColor" rx="0" opacity=".35"/><line x1="9" y1="20" x2="25" y2="20" stroke="currentColor" stroke-width="1.6"/></svg>
            Empotrado
          </div>
        </div>

        <div class="sec-title">Apoyo B <span class="sup-label simple" id="label-B">Simple</span></div>
        <div class="support-grid">
          <div class="sup-btn type-simple selected" id="supB-simple" onclick="selSup('B','simple',this)">
            <svg width="34" height="26" viewBox="0 0 34 26"><line x1="17" y1="3" x2="17" y2="17" stroke="currentColor" stroke-width="1.6"/><polygon points="17,17 9,24 25,24" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="7" y1="25" x2="27" y2="25" stroke="currentColor" stroke-width="1.6"/></svg>
            Simple
          </div>
          <div class="sup-btn type-pin" id="supB-pin" onclick="selSup('B','pin',this)">
            <svg width="34" height="26" viewBox="0 0 34 26"><line x1="17" y1="3" x2="17" y2="17" stroke="currentColor" stroke-width="1.6"/><polygon points="17,17 9,23 25,23" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="24.5" r="1.5" stroke="currentColor" fill="none" stroke-width="1.3"/></svg>
            Articulado
          </div>
          <div class="sup-btn type-fixed" id="supB-fixed" onclick="selSup('B','fixed',this)">
            <svg width="34" height="26" viewBox="0 0 34 26"><line x1="17" y1="3" x2="17" y2="20" stroke="currentColor" stroke-width="1.6"/><rect x="13" y="20" width="8" height="5" fill="currentColor" rx="0" opacity=".35"/><line x1="9" y1="20" x2="25" y2="20" stroke="currentColor" stroke-width="1.6"/></svg>
            Empotrado
          </div>
        </div>
      </div>

      <div class="card">
        <div class="sec-title">Cargas</div>
        <div style="display:flex;gap:.4rem;margin-bottom:.65rem;flex-wrap:wrap">
          <button class="btn btn-secondary btn-sm" onclick="setLoadMode('point')">+ Puntual</button>
          <button class="btn btn-secondary btn-sm" onclick="setLoadMode('dist')">+ Distribuida</button>
          <button class="btn btn-secondary btn-sm" onclick="setLoadMode('moment')">+ Momento</button>
        </div>
        <div id="load-form-point" class="card-sm" style="display:none">
          <div class="col3" style="margin-bottom:.4rem">
            <div><label>Posición (m)</label><input type="number" id="lp-pos" value="3" step="0.1"></div>
            <div><label>Magnitud (kN)</label><input type="number" id="lp-mag" value="10" step="1"></div>
            <div style="display:flex;align-items:flex-end"><button class="btn btn-primary btn-sm" style="width:100%" onclick="addLoad('point')">Agregar</button></div>
          </div>
        </div>
        <div id="load-form-dist" class="card-sm" style="display:none">
          <div class="col2" style="margin-bottom:.35rem">
            <div><label>Inicio (m)</label><input type="number" id="ld-a" value="0" step="0.1"></div>
            <div><label>Fin (m)</label><input type="number" id="ld-b" value="6" step="0.1"></div>
          </div>
          <div class="col2" style="margin-bottom:.35rem">
            <div><label>q inicio (kN/m)</label><input type="number" id="ld-qa" value="5" step="1"></div>
            <div><label>q fin (kN/m)</label><input type="number" id="ld-qb" value="5" step="1"></div>
          </div>
          <button class="btn btn-primary btn-sm" style="width:100%" onclick="addLoad('dist')">Agregar</button>
        </div>
        <div id="load-form-moment" class="card-sm" style="display:none">
          <div class="col2" style="margin-bottom:.35rem">
            <div><label>Posición (m)</label><input type="number" id="lm-pos" value="3" step="0.1"></div>
            <div><label>Magnitud (kN·m)</label><input type="number" id="lm-mag" value="8" step="1"></div>
          </div>
          <button class="btn btn-primary btn-sm" style="width:100%" onclick="addLoad('moment')">Agregar</button>
        </div>
        <div id="load-list" style="margin-top:.5rem"></div>
      </div>

      <button class="btn btn-primary" style="width:100%" onclick="updateDiagrams()">Calcular y Graficar</button>
    </div>

    <!-- RIGHT -->
    <div>
      <div class="card">
        <div class="sec-title">Estructura con Cargas</div>
        <canvas id="cvBeam" width="540" height="128"></canvas>
      </div>
      <div class="card">
        <div class="sec-title">Momentos M (kN·m)</div>
        <canvas id="cvM" width="540" height="110"></canvas>
      </div>
      <div class="card">
        <div class="sec-title">Corte Q (kN)</div>
        <canvas id="cvQ" width="540" height="110"></canvas>
      </div>
      <div class="card">
        <div class="sec-title">Axial N (kN)</div>
        <canvas id="cvN" width="540" height="70"></canvas>
      </div>
      <div id="results-mnq"></div>
    </div>
  </div>
</div>

<!-- ===== PANEL 2: BUILDER ===== -->
<div class="panel" id="panel-builder">
  <div class="col2">
    <!-- LEFT -->
    <div>
      <div class="card">
        <div class="sec-title">Longitud de la Estructura</div>
        <div><label>Longitud (m)</label><input type="number" id="bld-L" value="8" step="0.5" min="1" onchange="buildRender()"></div>
      </div>

      <div class="card">
        <div class="sec-title">Apoyos</div>
        <div class="col2" style="margin-bottom:.5rem">
          <div><label>Posición (m)</label><input type="number" id="bld-sup-pos" value="0" step="0.5" min="0"></div>
          <div><label>Tipo</label>
            <select id="bld-sup-type">
              <option value="simple">Simple (verde)</option>
              <option value="pin">Articulado (azul)</option>
              <option value="fixed">Empotrado (rojo)</option>
            </select>
          </div>
        </div>
        <button class="btn btn-primary btn-sm" style="width:100%" onclick="addBldSupport()">Agregar Apoyo</button>
        <div id="bld-sup-list" style="margin-top:.6rem"></div>
      </div>

      <div class="card">
        <div class="sec-title">Cargas</div>
        <div style="display:flex;gap:.4rem;margin-bottom:.6rem;flex-wrap:wrap">
          <button class="btn btn-secondary btn-sm" onclick="setBldMode('point')">+ Puntual</button>
          <button class="btn btn-secondary btn-sm" onclick="setBldMode('dist')">+ Distribuida</button>
          <button class="btn btn-secondary btn-sm" onclick="setBldMode('moment')">+ Momento</button>
        </div>
        <div id="bld-load-form-point" class="card-sm" style="display:none">
          <div class="col3" style="margin-bottom:.35rem">
            <div><label>Pos (m)</label><input type="number" id="blp-pos" value="4" step="0.1"></div>
            <div><label>Fuerza (kN)</label><input type="number" id="blp-mag" value="20" step="1"></div>
            <div style="display:flex;align-items:flex-end"><button class="btn btn-primary btn-sm" style="width:100%" onclick="addBldLoad('point')">+</button></div>
          </div>
        </div>
        <div id="bld-load-form-dist" class="card-sm" style="display:none">
          <div class="col2" style="margin-bottom:.35rem">
            <div><label>Inicio (m)</label><input type="number" id="bld-qa-pos" value="0" step="0.1"></div>
            <div><label>Fin (m)</label><input type="number" id="bld-qb-pos" value="8" step="0.1"></div>
          </div>
          <div class="col2" style="margin-bottom:.35rem">
            <div><label>q inicio (kN/m)</label><input type="number" id="bld-qa-val" value="10" step="1"></div>
            <div><label>q fin (kN/m)</label><input type="number" id="bld-qb-val" value="10" step="1"></div>
          </div>
          <button class="btn btn-primary btn-sm" style="width:100%" onclick="addBldLoad('dist')">+</button>
        </div>
        <div id="bld-load-form-moment" class="card-sm" style="display:none">
          <div class="col2" style="margin-bottom:.35rem">
            <div><label>Pos (m)</label><input type="number" id="blm-pos" value="4" step="0.1"></div>
            <div><label>M (kN·m)</label><input type="number" id="blm-mag" value="15" step="1"></div>
          </div>
          <button class="btn btn-primary btn-sm" style="width:100%" onclick="addBldLoad('moment')">+</button>
        </div>
        <div id="bld-load-list" style="margin-top:.5rem"></div>
      </div>

      <div style="display:flex;gap:.5rem">
        <button class="btn btn-primary" style="flex:1" onclick="calcBuilder()">Calcular</button>
        <button class="btn btn-secondary" onclick="resetBuilder()">Limpiar</button>
      </div>
    </div>

    <!-- RIGHT -->
    <div>
      <div class="card">
        <div class="sec-title">Vista de la Estructura</div>
        <canvas id="cvBld" width="540" height="135"></canvas>
      </div>
      <div class="card">
        <div class="sec-title">Momentos M (kN·m)</div>
        <canvas id="cvBldM" width="540" height="105"></canvas>
      </div>
      <div class="card">
        <div class="sec-title">Corte Q (kN)</div>
        <canvas id="cvBldQ" width="540" height="105"></canvas>
      </div>
      <div class="card" id="card-reactions" style="display:none">
        <div class="sec-title">Reacciones en Apoyos</div>
        <div id="bld-reactions"></div>
      </div>
      <div class="card" id="card-extremes" style="display:none">
        <div class="sec-title">Extremos M, Q, N</div>
        <div id="bld-extremes"></div>
      </div>
    </div>
  </div>
</div>

<script>
/* === STATE === */
const st = { supA:'simple', supB:'simple', loads:[], loadMode:null };
const bld = { supports:[], loads:[], loadMode:null };

/* === COLORS === */
const dark = matchMedia('(prefers-color-scheme:dark)').matches;
const C = {
  ink: dark?'#e8e5dc':'#1a1a1a', ink2:dark?'#b8b5ac':'#666', ink3:dark?'#787570':'#999',
  bg2:dark?'#221f1c':'#fff', bg3:dark?'#2a2722':'#f0ede6', border:dark?'#3a3730':'#e0ddd4',
  red:'#c84b2f', blue:'#2f6fc8', green:'#2a7a4b', amber:'#c87a2f'
};
// Support colors by type
const SUP_COLOR = { simple:C.green, pin:C.blue, roller:C.blue, fixed:C.red, free:C.ink3 };
const SUP_LABEL = { simple:'Simple', pin:'Articulado', roller:'Articulado', fixed:'Empotrado', free:'Libre' };

/* === TABS === */
function switchTab(t){
  document.querySelectorAll('.tab').forEach((el,i)=>el.classList.toggle('active',(i===0&&t==='mnq')||(i===1&&t==='builder')));
  document.querySelectorAll('.panel').forEach((el,i)=>el.classList.toggle('active',(i===0&&t==='mnq')||(i===1&&t==='builder')));
  if(t==='mnq')updateDiagrams(); else buildRender();
}

/* === SUPPORT SELECTION (MNQ) === */
function selSup(side,type,el){
  ['simple','pin','fixed'].forEach(t=>{
    const b=document.getElementById('sup'+side+'-'+t);
    if(b) b.classList.remove('selected');
  });
  el.classList.add('selected');
  st['sup'+side]=type;
  // Update inline label
  const lbl=document.getElementById('label-'+side);
  lbl.textContent=SUP_LABEL[type];
  lbl.className='sup-label '+(type==='simple'?'simple':type==='pin'?'pin':'fixed');
  updateDiagrams();
}

/* === LOAD MODES === */
function setLoadMode(m){
  st.loadMode=st.loadMode===m?null:m;
  ['point','dist','moment'].forEach(x=>document.getElementById('load-form-'+x).style.display=(st.loadMode===x?'block':'none'));
}
function setBldMode(m){
  bld.loadMode=bld.loadMode===m?null:m;
  ['point','dist','moment'].forEach(x=>document.getElementById('bld-load-form-'+x).style.display=(bld.loadMode===x?'block':'none'));
}

/* === LOADS MNQ === */
function addLoad(type){
  const L=+document.getElementById('viga-L').value;
  if(type==='point'){
    const pos=+document.getElementById('lp-pos').value,mag=+document.getElementById('lp-mag').value;
    if(pos<0||pos>L)return alert('Posición fuera del rango');
    st.loads.push({type,pos,mag,id:Date.now()});
  }else if(type==='dist'){
    st.loads.push({type,a:+document.getElementById('ld-a').value,b:+document.getElementById('ld-b').value,qa:+document.getElementById('ld-qa').value,qb:+document.getElementById('ld-qb').value,id:Date.now()});
  }else{
    st.loads.push({type:'moment',pos:+document.getElementById('lm-pos').value,mag:+document.getElementById('lm-mag').value,id:Date.now()});
  }
  renderLL(); updateDiagrams();
}
function removeLoad(id){st.loads=st.loads.filter(l=>l.id!==id);renderLL();updateDiagrams();}
function renderLL(){
  const div=document.getElementById('load-list');
  if(!st.loads.length){div.innerHTML='<div style="font-size:.75rem;color:var(--ink3)">Sin cargas</div>';return;}
  div.innerHTML=st.loads.map(l=>{
    const dot=l.type==='point'?'point':l.type==='dist'?'dist':'moment';
    const lbl=l.type==='point'?`Puntual ${l.mag} kN @ ${l.pos}m`:l.type==='dist'?`Dist. ${l.qa}–${l.qb} kN/m [${l.a}–${l.b}m]`:`Momento ${l.mag} kN·m @ ${l.pos}m`;
    return `<div class="load-item"><div class="load-dot ${dot}"></div><span class="load-name">${lbl}</span><button class="btn btn-secondary btn-sm" onclick="removeLoad(${l.id})" style="padding:.15rem .4rem;font-size:.7rem">✕</button></div>`;
  }).join('');
}

/* === CALC ENGINE === */
function calcBeam(L,supA,supB,loads){
  const N=300,dx=L/N;
  const xs=Array.from({length:N+1},(_,i)=>i*dx);
  let totalV=0,totalMA=0;
  loads.forEach(l=>{
    if(l.type==='point'){totalV+=l.mag;totalMA+=l.mag*l.pos;}
    else if(l.type==='dist'){
      const len=l.b-l.a,F=(l.qa+l.qb)/2*len;
      const xc=l.a+len*(l.qa+2*l.qb)/(3*((l.qa+l.qb)||1));
      totalV+=F;totalMA+=F*xc;
    }else if(l.type==='moment'){totalMA+=l.mag;}
  });
  let RA=0,RB=0,MA_fix=0;
  const isFixed_A=(supA==='fixed'),isFixed_B=(supB==='fixed');
  if(!isFixed_A&&!isFixed_B){RB=totalMA/L;RA=totalV-RB;}
  else if(isFixed_A&&!isFixed_B){RB=totalMA/L;RA=totalV-RB;MA_fix=-(totalV*L-totalMA)*(1/2);}
  else if(!isFixed_A&&isFixed_B){RA=(totalV*L-totalMA)/L;RB=totalV-RA;}
  else{RB=totalMA/L;RA=totalV-RB;MA_fix=-(totalV*L-totalMA)/2;}
  if(supA==='fixed'&&supB==='free'){RA=totalV;MA_fix=-totalMA;RB=0;}

  const Q=xs.map(x=>{
    let q=RA;
    loads.forEach(l=>{
      if(l.type==='point'&&x>l.pos)q-=l.mag;
      else if(l.type==='dist'){
        if(x>=l.b)q-=(l.qa+l.qb)/2*(l.b-l.a);
        else if(x>l.a){const t=(x-l.a)/(l.b-l.a),qx=l.qa+(l.qb-l.qa)*t;q-=(l.qa+qx)/2*(x-l.a);}
      }
    });
    return q;
  });
  const M=xs.map(x=>{
    let m=MA_fix+RA*x;
    loads.forEach(l=>{
      if(l.type==='point'&&x>l.pos)m-=l.mag*(x-l.pos);
      else if(l.type==='dist'){
        if(x>=l.b){const len=l.b-l.a,F=(l.qa+l.qb)/2*len,xc=l.a+len*(l.qa+2*l.qb)/(3*((l.qa+l.qb)||1));m-=F*(x-xc);}
        else if(x>l.a){const len2=x-l.a,t=len2/(l.b-l.a),qx=l.qa+(l.qb-l.qa)*t,F=(l.qa+qx)/2*len2,xc2=l.a+len2*(l.qa+2*qx)/(3*((l.qa+qx)||1));m-=F*(x-xc2);}
      }
      else if(l.type==='moment'&&x>l.pos)m-=l.mag;
    });
    return m;
  });
  return{xs,Q,M,RA,RB,MA_fix};
}

/* === DRAW HELPERS === */
function drawArrow(ctx,x1,y1,x2,y2,color,hw=5){
  const a=Math.atan2(y2-y1,x2-x1);
  ctx.strokeStyle=color;ctx.fillStyle=color;ctx.lineWidth=1.6;
  ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();
  ctx.beginPath();ctx.moveTo(x2,y2);
  ctx.lineTo(x2-hw*Math.cos(a-.4),y2-hw*Math.sin(a-.4));
  ctx.lineTo(x2-hw*Math.cos(a+.4),y2-hw*Math.sin(a+.4));
  ctx.closePath();ctx.fill();
}

function drawDiagram(cv,xs,vals,color,L,yPad=12){
  const ctx=cv.getContext('2d'),W=cv.width,H=cv.height;
  ctx.clearRect(0,0,W,H);
  const pad={l:44,r:14,t:yPad,b:18},cw=W-pad.l-pad.r,ch=H-pad.t-pad.b;
  const maxV=Math.max(...vals.map(Math.abs),.01);
  const zero=pad.t+ch/2;
  ctx.strokeStyle=C.border;ctx.lineWidth=.8;ctx.setLineDash([3,4]);
  ctx.beginPath();ctx.moveTo(pad.l,zero);ctx.lineTo(pad.l+cw,zero);ctx.stroke();ctx.setLineDash([]);
  // fill
  ctx.beginPath();ctx.moveTo(pad.l,zero);
  xs.forEach((x,i)=>{const px=pad.l+(x/L)*cw,py=zero-(vals[i]/maxV)*(ch/2)*.88;ctx.lineTo(px,py);});
  ctx.lineTo(pad.l+cw,zero);ctx.closePath();
  const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,color+'55');g.addColorStop(1,color+'10');
  ctx.fillStyle=g;ctx.fill();
  // line
  ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=2;
  xs.forEach((x,i)=>{const px=pad.l+(x/L)*cw,py=zero-(vals[i]/maxV)*(ch/2)*.88;i===0?ctx.moveTo(px,py):ctx.lineTo(px,py);});
  ctx.stroke();
  // labels
  ctx.font='10px DM Mono,monospace';ctx.fillStyle=C.ink3;ctx.textAlign='right';
  [[maxV,0],[0,ch/2],[- maxV,ch]].forEach(([v,dy])=>ctx.fillText(v.toFixed(1),pad.l-4,pad.t+dy+3));
  ctx.textAlign='center';
  [0,L/2,L].forEach(v=>ctx.fillText(v.toFixed(1)+'m',pad.l+(v/L)*cw,H-3));
}

/* === DRAW BEAM (MNQ) === */
function drawBeam(cv,L,supA,supB,loads,RA,RB){
  const ctx=cv.getContext('2d'),W=cv.width,H=cv.height;
  ctx.clearRect(0,0,W,H);
  const pad={l:55,r:55,t:34,b:44};
  const cw=W-pad.l-pad.r,y0=pad.t+26;
  const xOf=x=>pad.l+(x/L)*cw;
  // beam
  ctx.strokeStyle=C.ink;ctx.lineWidth=3.5;
  ctx.beginPath();ctx.moveTo(pad.l,y0);ctx.lineTo(pad.l+cw,y0);ctx.stroke();
  // supports
  function drawSup(type,xPos,R){
    const tx=xOf(xPos),col=SUP_COLOR[type]||C.ink;
    ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=1.6;
    if(type==='simple'){
      ctx.beginPath();ctx.moveTo(tx,y0);ctx.lineTo(tx-10,y0+17);ctx.lineTo(tx+10,y0+17);ctx.closePath();ctx.stroke();
      ctx.beginPath();ctx.moveTo(tx-13,y0+19);ctx.lineTo(tx+13,y0+19);ctx.stroke();
    }else if(type==='pin'){
      ctx.beginPath();ctx.moveTo(tx,y0);ctx.lineTo(tx-9,y0+15);ctx.lineTo(tx+9,y0+15);ctx.closePath();ctx.stroke();
      ctx.beginPath();ctx.arc(tx,y0+17,2.2,0,Math.PI*2);ctx.stroke();
    }else if(type==='fixed'){
      ctx.globalAlpha=.25;ctx.fillRect(tx-10,y0-11,8,22);ctx.globalAlpha=1;
      ctx.strokeRect(tx-10,y0-11,8,22);
    }
    // reaction arrow
    if(R!==undefined&&Math.abs(R)>0.01){
      const col2=C.green;
      drawArrow(ctx,tx,y0+34,tx,y0+2,col2);
      ctx.font='9px DM Mono,monospace';ctx.fillStyle=col2;ctx.textAlign='center';
      ctx.fillText(Math.abs(R).toFixed(1)+'kN',tx,y0+48);
    }
  }
  drawSup(supA,0,RA);
  drawSup(supB,L,RB);
  // loads
  const maxMag=Math.max(...loads.map(l=>l.type==='point'?Math.abs(l.mag):l.type==='dist'?Math.max(Math.abs(l.qa||0),Math.abs(l.qb||0)):Math.abs(l.mag||0)),1);
  loads.forEach(l=>{
    if(l.type==='point'){
      const tx=xOf(l.pos),al=Math.max(18,Math.abs(l.mag)/maxMag*32);
      drawArrow(ctx,tx,y0-al,tx,y0-1,C.red);
      ctx.font='9px DM Mono,monospace';ctx.fillStyle=C.red;ctx.textAlign='center';
      ctx.fillText(l.mag.toFixed(1)+'kN',tx,y0-al-5);
    }else if(l.type==='dist'){
      const ax=xOf(l.a),bx=xOf(l.b);
      const sA=Math.max(8,Math.abs(l.qa)/maxMag*28),sB=Math.max(8,Math.abs(l.qb)/maxMag*28);
      ctx.strokeStyle=C.blue;ctx.fillStyle=C.blue+'22';ctx.lineWidth=1.1;
      ctx.beginPath();ctx.moveTo(ax,y0-sA);ctx.lineTo(bx,y0-sB);ctx.lineTo(bx,y0);ctx.lineTo(ax,y0);ctx.closePath();ctx.fill();ctx.stroke();
      const steps=Math.max(2,Math.floor((bx-ax)/14));
      for(let s=0;s<=steps;s++){const fx=ax+s*(bx-ax)/steps,fy=y0-(sA+(sB-sA)*s/steps);drawArrow(ctx,fx,fy,fx,y0-1,C.blue,3);}
      ctx.font='9px DM Mono,monospace';ctx.fillStyle=C.blue;ctx.textAlign='center';
      ctx.fillText(l.qa.toFixed(1)+'kN/m',ax,y0-sA-5);
    }else if(l.type==='moment'){
      const tx=xOf(l.pos);
      ctx.strokeStyle=C.amber;ctx.lineWidth=2;
      ctx.beginPath();ctx.arc(tx,y0,10,-Math.PI*.8,Math.PI*.8,l.mag<0);ctx.stroke();
      ctx.font='9px DM Mono,monospace';ctx.fillStyle=C.amber;ctx.textAlign='center';
      ctx.fillText(l.mag.toFixed(1)+'kN·m',tx,y0-18);
    }
  });
}

/* === UPDATE MNQ === */
function updateDiagrams(){
  const L=+document.getElementById('viga-L').value||6;
  const{xs,Q,M,RA,RB}=calcBeam(L,st.supA,st.supB,st.loads);
  drawBeam(document.getElementById('cvBeam'),L,st.supA,st.supB,st.loads,RA,RB);
  drawDiagram(document.getElementById('cvM'),xs,M,C.red,L);
  drawDiagram(document.getElementById('cvQ'),xs,Q,C.blue,L);
  const cvN=document.getElementById('cvN');
  const ctxN=cvN.getContext('2d');ctxN.clearRect(0,0,cvN.width,cvN.height);
  ctxN.font='11px DM Mono,monospace';ctxN.fillStyle=C.ink3;ctxN.textAlign='center';
  ctxN.fillText('N = 0.00 kN (sin carga axial)',cvN.width/2,cvN.height/2+4);
  const Mm=Math.max(...M),Mn=Math.min(...M),Qm=Math.max(...Q),Qn=Math.min(...Q);
  document.getElementById('results-mnq').innerHTML=`
    <div class="result-grid">
      <div class="result-card green"><div class="result-label">RA (kN)</div><div class="result-val">${RA.toFixed(2)}</div></div>
      <div class="result-card blue"><div class="result-label">RB (kN)</div><div class="result-val">${RB.toFixed(2)}</div></div>
      <div class="result-card"><div class="result-label">M máx (kN·m)</div><div class="result-val">${Mm.toFixed(2)}</div></div>
      <div class="result-card amber"><div class="result-label">M mín (kN·m)</div><div class="result-val">${Mn.toFixed(2)}</div></div>
      <div class="result-card blue"><div class="result-label">Q+ (kN)</div><div class="result-val">${Qm.toFixed(2)}</div></div>
      <div class="result-card"><div class="result-label">Q− (kN)</div><div class="result-val">${Qn.toFixed(2)}</div></div>
    </div>`;
}

/* === BUILDER === */
function addBldSupport(){
  const pos=+document.getElementById('bld-sup-pos').value;
  const type=document.getElementById('bld-sup-type').value;
  const L=+document.getElementById('bld-L').value;
  if(pos<0||pos>L)return alert('Posición fuera del rango');
  if(bld.supports.some(s=>Math.abs(s.pos-pos)<0.01))return alert('Ya existe un apoyo en esa posición');
  bld.supports.push({pos,type,id:Date.now()});
  bld.supports.sort((a,b)=>a.pos-b.pos);
  renderBldSup();buildRender();
}
function removeBldSupport(id){bld.supports=bld.supports.filter(s=>s.id!==id);renderBldSup();buildRender();}
function renderBldSup(){
  const div=document.getElementById('bld-sup-list');
  if(!bld.supports.length){div.innerHTML='<div style="font-size:.75rem;color:var(--ink3)">Sin apoyos</div>';return;}
  div.innerHTML=bld.supports.map(s=>`
    <div class="load-item">
      <div class="load-dot" style="background:${SUP_COLOR[s.type]||C.ink}"></div>
      <span class="load-name"><span class="sup-label ${s.type==='simple'?'simple':s.type==='pin'?'pin':'fixed'}">${SUP_LABEL[s.type]}</span> @ ${s.pos}m</span>
      <button class="btn btn-secondary btn-sm" onclick="removeBldSupport(${s.id})" style="padding:.15rem .4rem;font-size:.7rem">✕</button>
    </div>`).join('');
}
function addBldLoad(type){
  const L=+document.getElementById('bld-L').value;
  if(type==='point') bld.loads.push({type,pos:+document.getElementById('blp-pos').value,mag:+document.getElementById('blp-mag').value,id:Date.now()});
  else if(type==='dist') bld.loads.push({type,a:+document.getElementById('bld-qa-pos').value,b:+document.getElementById('bld-qb-pos').value,qa:+document.getElementById('bld-qa-val').value,qb:+document.getElementById('bld-qb-val').value,id:Date.now()});
  else bld.loads.push({type:'moment',pos:+document.getElementById('blm-pos').value,mag:+document.getElementById('blm-mag').value,id:Date.now()});
  renderBldLoads();buildRender();
}
function removeBldLoad(id){bld.loads=bld.loads.filter(l=>l.id!==id);renderBldLoads();buildRender();}
function renderBldLoads(){
  const div=document.getElementById('bld-load-list');
  if(!bld.loads.length){div.innerHTML='<div style="font-size:.75rem;color:var(--ink3)">Sin cargas</div>';return;}
  div.innerHTML=bld.loads.map(l=>{
    const dot=l.type==='point'?'point':l.type==='dist'?'dist':'moment';
    const lbl=l.type==='point'?`Puntual ${l.mag}kN @ ${l.pos}m`:l.type==='dist'?`Dist. ${l.qa}–${l.qb} kN/m [${l.a}–${l.b}m]`:`Momento ${l.mag}kN·m @ ${l.pos}m`;
    return `<div class="load-item"><div class="load-dot ${dot}"></div><span class="load-name">${lbl}</span><button class="btn btn-secondary btn-sm" onclick="removeBldLoad(${l.id})" style="padding:.15rem .4rem;font-size:.7rem">✕</button></div>`;
  }).join('');
}

function buildRender(){
  const L=+document.getElementById('bld-L').value||8;
  const cv=document.getElementById('cvBld'),ctx=cv.getContext('2d'),W=cv.width,H=cv.height;
  ctx.clearRect(0,0,W,H);
  const pad={l:48,r:48,t:38,b:48},cw=W-pad.l-pad.r,y0=pad.t+26;
  const xOf=x=>pad.l+(x/L)*cw;
  // beam
  ctx.strokeStyle=C.ink;ctx.lineWidth=3.5;
  ctx.beginPath();ctx.moveTo(pad.l,y0);ctx.lineTo(pad.l+cw,y0);ctx.stroke();
  // dimension
  ctx.strokeStyle=C.ink3;ctx.lineWidth=.7;ctx.setLineDash([2,3]);
  ctx.beginPath();ctx.moveTo(pad.l,y0+28);ctx.lineTo(pad.l+cw,y0+28);ctx.stroke();ctx.setLineDash([]);
  ctx.font='9px DM Mono,monospace';ctx.fillStyle=C.ink3;ctx.textAlign='center';
  ctx.fillText('L = '+L.toFixed(1)+' m',pad.l+cw/2,y0+42);
  // supports
  bld.supports.forEach(s=>{
    const tx=xOf(s.pos),col=SUP_COLOR[s.type]||C.ink;
    ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=1.6;
    if(s.type==='simple'){
      ctx.beginPath();ctx.moveTo(tx,y0);ctx.lineTo(tx-10,y0+17);ctx.lineTo(tx+10,y0+17);ctx.closePath();ctx.stroke();
      ctx.beginPath();ctx.moveTo(tx-13,y0+19);ctx.lineTo(tx+13,y0+19);ctx.stroke();
    }else if(s.type==='pin'){
      ctx.beginPath();ctx.moveTo(tx,y0);ctx.lineTo(tx-9,y0+15);ctx.lineTo(tx+9,y0+15);ctx.closePath();ctx.stroke();
      ctx.beginPath();ctx.arc(tx,y0+17,2.2,0,Math.PI*2);ctx.stroke();
    }else if(s.type==='fixed'){
      ctx.globalAlpha=.22;ctx.fillRect(tx-10,y0-11,8,22);ctx.globalAlpha=1;
      ctx.strokeRect(tx-10,y0-11,8,22);
    }
    ctx.font='9px DM Mono,monospace';ctx.fillStyle=col;ctx.textAlign='center';
    ctx.fillText(s.pos.toFixed(1)+'m',tx,y0-16);
  });
  // loads
  const maxMag=Math.max(...bld.loads.map(l=>l.type==='point'?Math.abs(l.mag):l.type==='dist'?Math.max(Math.abs(l.qa||0),Math.abs(l.qb||0)):Math.abs(l.mag||0)),1);
  bld.loads.forEach(l=>{
    if(l.type==='point'){
      const tx=xOf(l.pos),al=Math.max(16,Math.abs(l.mag)/maxMag*28);
      drawArrow(ctx,tx,y0-al,tx,y0-1,C.red);
      ctx.font='9px DM Mono,monospace';ctx.fillStyle=C.red;ctx.textAlign='center';
      ctx.fillText(l.mag.toFixed(0)+'kN',tx,y0-al-5);
    }else if(l.type==='dist'){
      const ax=xOf(l.a),bx=xOf(l.b),sA=Math.max(8,Math.abs(l.qa)/maxMag*24),sB=Math.max(8,Math.abs(l.qb)/maxMag*24);
      ctx.strokeStyle=C.blue;ctx.fillStyle=C.blue+'22';ctx.lineWidth=1;
      ctx.beginPath();ctx.moveTo(ax,y0-sA);ctx.lineTo(bx,y0-sB);ctx.lineTo(bx,y0);ctx.lineTo(ax,y0);ctx.closePath();ctx.fill();ctx.stroke();
      const steps=Math.max(2,Math.floor((bx-ax)/14));
      for(let i=0;i<=steps;i++){const fx=ax+i*(bx-ax)/steps,fy=y0-(sA+(sB-sA)*i/steps);drawArrow(ctx,fx,fy,fx,y0-1,C.blue,3);}
    }else if(l.type==='moment'){
      const tx=xOf(l.pos);ctx.strokeStyle=C.amber;ctx.lineWidth=2;
      ctx.beginPath();ctx.arc(tx,y0,9,-Math.PI*.75,Math.PI*.75,l.mag<0);ctx.stroke();
    }
  });
}

function calcBuilder(){
  const L=+document.getElementById('bld-L').value||8;
  if(bld.supports.length<2)return alert('Necesitás al menos 2 apoyos para calcular');
  const sups=bld.supports;
  const supA=sups[0].type,supB=sups[sups.length-1].type;
  const{xs,Q,M,RA,RB}=calcBeam(L,supA,supB,bld.loads);
  drawDiagram(document.getElementById('cvBldM'),xs,M,C.red,L);
  drawDiagram(document.getElementById('cvBldQ'),xs,Q,C.blue,L);
  buildRender();
  // Reaction arrows on build canvas
  const cv=document.getElementById('cvBld'),ctx=cv.getContext('2d');
  const pad={l:48,r:48,t:38,b:48},cw=cv.width-pad.l-pad.r,y0=pad.t+26;
  const xOf=x=>pad.l+(x/L)*cw;
  [sups[0],sups[sups.length-1]].forEach((s,i)=>{
    const R=i===0?RA:RB,tx=xOf(s.pos);
    drawArrow(ctx,tx,y0+34,tx,y0+2,C.green);
    ctx.font='9px DM Mono,monospace';ctx.fillStyle=C.green;ctx.textAlign='center';
    ctx.fillText(R.toFixed(1)+'kN',tx,y0+48);
  });
  // Show result cards
  document.getElementById('card-reactions').style.display='block';
  document.getElementById('card-extremes').style.display='block';
  const reactionHTML=sups.map((s,i)=>{
    const R=i===0?RA:(i===sups.length-1?RB:null);
    if(R===null)return'';
    const cls=i===0?'green':'blue';
    return`<div class="result-card ${cls}"><div class="result-label">R @ ${s.pos}m (kN)</div><div class="result-val">${R.toFixed(2)}</div></div>`;
  }).join('');
  document.getElementById('bld-reactions').innerHTML=`<div class="result-grid">${reactionHTML}</div>`;
  const Mm=Math.max(...M),Mn=Math.min(...M),Qm=Math.max(...Q),Qn=Math.min(...Q);
  document.getElementById('bld-extremes').innerHTML=`
    <div class="result-grid">
      <div class="result-card"><div class="result-label">M máx (kN·m)</div><div class="result-val">${Mm.toFixed(2)}</div></div>
      <div class="result-card amber"><div class="result-label">M mín (kN·m)</div><div class="result-val">${Mn.toFixed(2)}</div></div>
      <div class="result-card blue"><div class="result-label">Q+ máx (kN)</div><div class="result-val">${Qm.toFixed(2)}</div></div>
      <div class="result-card"><div class="result-label">Q− mín (kN)</div><div class="result-val">${Qn.toFixed(2)}</div></div>
      <div class="result-card green"><div class="result-label">N (kN)</div><div class="result-val">0.00</div></div>
    </div>`;
}

function resetBuilder(){
  bld.supports=[];bld.loads=[];bld.loadMode=null;
  ['point','dist','moment'].forEach(m=>{const el=document.getElementById('bld-load-form-'+m);if(el)el.style.display='none';});
  renderBldSup();renderBldLoads();buildRender();
  ['card-reactions','card-extremes'].forEach(id=>document.getElementById(id).style.display='none');
  ['cvBldM','cvBldQ'].forEach(id=>{const cv=document.getElementById(id);cv.getContext('2d').clearRect(0,0,cv.width,cv.height);});
}

/* === INIT === */
renderLL();updateDiagrams();buildRender();
</script>
